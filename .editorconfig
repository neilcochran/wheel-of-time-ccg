# Editor defaults that match the Prettier config, so a file looks the same
# before it is formatted as after.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.csv]
insert_final_newline = false
trim_trailing_whitespace = false
